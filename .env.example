# Copy this file to .env and adjust values as needed.

PORT=1337
PARSE_MOUNT=/parse

# MongoDB connection string. When you write your docker-compose.yml, point this
# at your mongo service, e.g. mongodb://mongo:27017/crud
DATABASE_URI=mongodb://localhost:27017/crud_dev

APP_ID=myAppId
MASTER_KEY=myMasterKey
MAINTENANCE_KEY=myMaintenanceKey

# Publicly reachable URL where this server's /parse mount can be reached.
SERVER_URL=http://localhost:1337/parse
